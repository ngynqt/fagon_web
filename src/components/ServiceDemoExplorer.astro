---
import type { PortfolioItem } from '../data/portfolio';
import ProjectCard from './ProjectCard.astro';
import InteractiveGameDemo from './InteractiveGameDemo.astro';
import BeforeAfterDemo from './BeforeAfterDemo.astro';

interface Props {
  demoItems: PortfolioItem[];
}

const { demoItems } = Astro.props;
---

<dialog class="service-demo-dialog" data-demo-dialog aria-labelledby="service-demo-dialog-title" data-demo-controller>
  <div class="service-demo-dialog__bar">
    <strong id="service-demo-dialog-title">Sản phẩm mẫu</strong>
    <button type="button" class="btn btn--outline service-demo-dialog__close" data-demo-dialog-close aria-label="Đóng demo">Đóng</button>
  </div>
  <div data-demo-dialog-host></div>
</dialog>

<div class="service-demo-stage" data-demo-stage hidden>
  {demoItems.map((item) => {
    return (
      <article class="service-demo-panel" data-demo-panel={item.serviceId} aria-label={`Demo: ${item.serviceLabel}`}>
        {
          item.mediaType === 'before-after' ? <BeforeAfterDemo /> :
          item.mediaType === 'interactive-game' ? <InteractiveGameDemo /> :
          item.mediaType === 'slide-preview' ? (
            <div class="slide-demo" data-slide-demo tabindex="0" aria-label={`Trình xem slide: ${item.title}`}>
              <div class="slide-demo__viewport">
                <section class="slide-demo__page is-active" data-slide-page>
                  <img src={item.resourcePath} alt={`Trang minh họa của ${item.title}`} width="800" height="500" />
                </section>
                <section class="slide-demo__page" data-slide-page hidden>
                  <span class="slide-demo__kicker">NỘI DUNG CỐT LÕI</span>
                  <h4>{item.visualData.headline}</h4>
                  <p>{item.visualData.subheadline}</p>
                </section>
                <section class="slide-demo__page" data-slide-page hidden>
                  <span class="slide-demo__kicker">ĐIỂM NHẤN BÀI GIẢNG</span>
                  <ul>{item.visualData.metricsOrPoints.map((point) => <li>{point}</li>)}</ul>
                </section>
              </div>
              <div class="slide-demo__controls">
                <button type="button" class="btn btn--outline" data-slide-prev>← Trước</button>
                <span data-slide-count>1 / 3</span>
                <button type="button" class="btn btn--dark" data-slide-next>Sau →</button>
              </div>
            </div>
          ) : <ProjectCard item={item} />
        }
      </article>
    );
  })}
</div>

<div class="demo-unavailable" data-demo-unavailable hidden role="status">Sản phẩm mẫu cho dịch vụ này đang được cập nhật.</div>

<style>
  .service-demo-stage { width:100%; }
  .service-demo-panel { margin:0; }
  .service-demo-dialog { width:min(1000px, calc(100vw - 2rem)); max-height:calc(100vh - 2rem); padding:0; border:2px solid var(--color-ink); border-radius:var(--radius-lg); background:var(--color-cream); }
  .service-demo-dialog::backdrop { background:rgba(25,27,24,.65); backdrop-filter:blur(3px); }
  .service-demo-dialog__bar { display:flex; justify-content:space-between; align-items:center; padding:1rem 1.25rem; border-bottom:1px solid var(--color-border); position:sticky; top:0; background:var(--color-cream); z-index:2; }
  .service-demo-dialog [data-demo-dialog-host] { padding:1.25rem; }
  .service-demo-dialog__close { font-size:.84rem; }
  .demo-unavailable { position:fixed; right:1rem; bottom:1rem; z-index:20; max-width:min(28rem,calc(100vw - 2rem)); background:var(--color-cream-alt); border:1px dashed var(--color-border); border-radius:var(--radius-sm); padding:.85rem 1rem; color:var(--color-text-muted); font-weight:600; box-shadow:var(--shadow-card); }
  .slide-demo { border:1.5px solid var(--color-ink); border-radius:var(--radius-sm); overflow:hidden; background:var(--color-cream); outline:none; }
  .slide-demo:focus-visible { outline:3px solid var(--color-lime); outline-offset:3px; }
  .slide-demo__viewport { min-height:clamp(280px,38vw,460px); display:grid; }
  .slide-demo__page { grid-area:1/1; padding:clamp(1.25rem,5vw,4rem); display:flex; flex-direction:column; justify-content:center; align-items:flex-start; background:var(--color-cream); }
  .slide-demo__page img { width:100%; height:100%; object-fit:cover; border-radius:4px; }
  .slide-demo__page h4 { font-family:var(--font-display); font-size:clamp(1.5rem,4vw,3rem); max-width:18ch; margin:.4rem 0 1rem; }
  .slide-demo__page p, .slide-demo__page li { color:var(--color-text-muted); font-size:clamp(.92rem,1.8vw,1.08rem); }
  .slide-demo__page ul { display:grid; gap:.7rem; max-width:58ch; padding-left:1.2rem; }
  .slide-demo__kicker { font-size:.75rem; font-weight:800; letter-spacing:.08em; color:var(--color-text-muted); }
  .slide-demo__controls { display:flex; align-items:center; justify-content:center; gap:1rem; padding:.75rem; background:var(--color-surface); border-top:1px solid var(--color-border); font-size:.85rem; font-weight:700; }
  @media (max-width:600px) { .service-demo-dialog [data-demo-dialog-host] { padding:.75rem; } .slide-demo__controls { gap:.5rem; } }
</style>

<script>
  const controller = document.querySelector<HTMLElement>('[data-demo-controller]');
  if (controller) {
    const stage = document.querySelector<HTMLElement>('[data-demo-stage]');
    const dialog = document.querySelector<HTMLDialogElement>('[data-demo-dialog]');
    const dialogHost = document.querySelector<HTMLElement>('[data-demo-dialog-host]');
    const unavailable = document.querySelector<HTMLElement>('[data-demo-unavailable]');
    const openButtons = document.querySelectorAll<HTMLButtonElement>('[data-service-demo]');
    let opener: HTMLButtonElement | null = null;

    const stopDemoVideos = () => {
      stage?.querySelectorAll<HTMLVideoElement>('video').forEach((video) => {
        video.pause();
        video.currentTime = 0;
      });
    };

    const placeDemo = (serviceId: string, trigger?: HTMLButtonElement) => {
      opener = trigger ?? opener;
      const panel = stage?.querySelector<HTMLElement>(`[data-demo-panel="${serviceId}"]`);
      if (unavailable) unavailable.hidden = true;
      if (!panel || !stage) {
        if (unavailable) { unavailable.hidden = false; window.setTimeout(() => { unavailable.hidden = true; }, 3500); }
        return;
      }
      stage.querySelectorAll<HTMLElement>('[data-demo-panel]').forEach((item) => {
        item.hidden = item !== panel;
      });
      stage.hidden = false;
      if (dialog && dialogHost) {
        dialogHost.append(stage);
        if (!dialog.open) dialog.showModal();
        dialog.querySelector<HTMLElement>('[data-demo-dialog-close]')?.focus();
      }
    };

    openButtons.forEach((button) => button.addEventListener('click', () => placeDemo(button.dataset.serviceDemo || '', button)));
    dialog?.querySelector<HTMLButtonElement>('[data-demo-dialog-close]')?.addEventListener('click', () => dialog.close());
    dialog?.addEventListener('close', () => {
      stopDemoVideos();
      if (stage) stage.hidden = true;
      opener?.focus();
    });

    document.querySelectorAll<HTMLElement>('[data-slide-demo]').forEach((demo) => {
      const pages = Array.from(demo.querySelectorAll<HTMLElement>('[data-slide-page]'));
      const count = demo.querySelector<HTMLElement>('[data-slide-count]');
      let index = 0;
      const update = () => { pages.forEach((page, i) => { page.hidden = i !== index; page.classList.toggle('is-active', i === index); }); if (count) count.textContent = `${index + 1} / ${pages.length}`; };
      demo.querySelector<HTMLButtonElement>('[data-slide-prev]')?.addEventListener('click', () => { index = (index - 1 + pages.length) % pages.length; update(); });
      demo.querySelector<HTMLButtonElement>('[data-slide-next]')?.addEventListener('click', () => { index = (index + 1) % pages.length; update(); });
      demo.addEventListener('keydown', (event) => { if (event.key === 'ArrowLeft') { index = (index - 1 + pages.length) % pages.length; update(); } if (event.key === 'ArrowRight') { index = (index + 1) % pages.length; update(); } });
    });
  }
</script>
