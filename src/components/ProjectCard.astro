---
import type { PortfolioItem } from '../data/portfolio';

interface Props {
  item: PortfolioItem;
  priorityLoad?: boolean;
  demoInModal?: boolean;
  uniformMeta?: boolean;
}

const { item, priorityLoad = false, demoInModal = false, uniformMeta = false } = Astro.props;
const isImagePreview = /\.(webp|png|svg|jpg|jpeg)$/i.test(item.resourcePath);
---

<article class="card project-card" data-demo-code={item.code}>
  <div class="project-card__main">
    <!-- Top Meta Bar: Code + Strict Demo Label (Section 9) -->
    <div class:list={['project-card__meta', { 'project-card__meta--uniform': uniformMeta }]}>
      <span class="project-card__code">Mã: {item.code}</span>
      <span
        class:list={[
          'badge',
          item.demoLabel === 'Demo minh họa' ? 'badge--lime' : 'badge--dark',
        ]}
      >
        {item.demoLabel}
      </span>
    </div>

    <!-- Fixed Aspect Ratio Media Frame to prevent layout shift (CLS = 0) -->
    <div class="project-card__media" id={item.id}>
      {
        item.videoPath ? (
          <div class="project-card__media-toggle-container">
            <div class="project-card__media-view project-card__media-view--video" data-view="video">
              <video
                src={item.videoPath}
                poster={item.posterPath || item.resourcePath}
                preload="metadata"
                playsinline
                class="project-card__video"
                aria-label={`${item.title} — Video demo thực tế`}
              >
                Trình duyệt của bạn không hỗ trợ thẻ video HTML5.
              </video>
              <button type="button" class="video-play-overlay" data-video-play aria-label="Phát video">▶</button>
              <div class="video-controls" data-video-controls>
                <button type="button" class="video-control-btn" data-video-toggle aria-label="Phát video">▶</button>
                <span class="video-time" data-video-time>0:00 / 0:00</span>
                <input class="video-progress" type="range" min="0" max="100" value="0" step="0.1" data-video-progress aria-label="Tiến trình video" />
                <button type="button" class="video-control-btn" data-video-mute aria-label="Bật hoặc tắt âm thanh">🔊</button>
              </div>
            </div>
            {item.showMediaSwitcher && item.resourcePath && (
              <div class="project-card__media-view project-card__media-view--image" data-view="image" hidden>
                <img
                  src={item.resourcePath}
                  alt={`Bảng phân cảnh Storyboard: ${item.title}`}
                  width="800"
                  height="500"
                  loading="lazy"
                  decoding="async"
                  class="project-card__img"
                />
              </div>
            )}
            {item.showMediaSwitcher && <div class="project-card__media-switcher">
              <button
                type="button"
                class="media-switch-btn is-active"
                data-switch-to="video"
                aria-label="Xem video phát thực tế"
              >
                ▶ Video 60s
              </button>
              <button
                type="button"
                class="media-switch-btn"
                data-switch-to="image"
                aria-label="Xem bảng phân cảnh Storyboard"
              >
                🖼 Storyboard
              </button>
            </div>}
          </div>
        ) : isImagePreview ? (
          <img
            src={item.resourcePath}
            alt={`${item.demoLabel}: ${item.title}`}
            width="800"
            height="500"
            loading={priorityLoad ? 'eager' : 'lazy'}
            decoding="async"
            class="project-card__img"
          />
        ) : (
          <div class="project-card__visual-box">
            <span class="project-card__eyebrow">{item.visualData.eyebrow}</span>
            <strong class="project-card__visual-headline">{item.visualData.headline}</strong>
            <p class="project-card__visual-sub">{item.visualData.subheadline}</p>
            <span class="badge badge--lime">{item.visualData.accentTag}</span>
          </div>
        )
      }
    </div>

    <div class="project-card__content">
      <span class="project-card__service-tag">{item.serviceLabel}</span>
      <h3 class="project-card__title">{item.title}</h3>
      <p class="project-card__desc">{item.description}</p>

      <ul class="project-card__points">
        {item.visualData.metricsOrPoints.map((pt) => <li>{pt}</li>)}
      </ul>

    </div>
  </div>

  <div class="project-card__actions">
    <div class="project-card__buttons">
      {
        /* Rule 9: Only show experience button when an actual interactive feature exists */
        item.liveExperienceAnchor && (
          demoInModal ? (
            <button type="button" class="btn btn--primary project-card__btn" data-service-demo={item.serviceId}>
              Trải nghiệm demo →
            </button>
          ) : (
            <a href={item.liveExperienceAnchor} class="btn btn--primary project-card__btn">
              {item.videoPath ? 'Xem video ngay ▶' : 'Trải nghiệm demo thật →'}
            </a>
          )
        )
      }
      <a
        href="#yeu-cau-tu-van"
        class="btn btn--outline project-card__btn"
        data-select-service={item.serviceId}
        data-select-service-label={item.serviceLabel}
      >
        Đặt làm mẫu tương tự
      </a>
    </div>

  </div>
</article>

<style>
  .project-card {
    gap: 1.25rem;
  }

  .project-card__meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    margin-bottom: 0.85rem;
  }

  .project-card__meta--uniform {
    min-height: 2.2rem;
  }

  .project-card__code {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--color-text-muted);
    font-family: monospace;
  }

  .project-card__media {
    width: 100%;
    aspect-ratio: 16 / 10;
    background-color: var(--color-cream);
    border: 1.5px solid var(--color-ink);
    border-radius: var(--radius-sm);
    overflow: hidden;
    margin-bottom: 1.15rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .project-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .project-card__visual-box {
    padding: 1.35rem;
    width: 100%;
    height: 100%;
    background-color: var(--color-ink);
    color: var(--color-cream);
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    gap: 0.45rem;
  }

  .project-card__eyebrow {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--color-lime);
  }

  .project-card__visual-headline {
    font-family: var(--font-display);
    font-size: 1.35rem;
    line-height: 1.25;
    color: var(--color-cream);
  }

  .project-card__visual-sub {
    font-size: 0.84rem;
    color: #d0d3ca;
    margin: 0 0 0.35rem 0;
  }

  .project-card__service-tag {
    display: inline-block;
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--color-text-muted);
    margin-bottom: 0.3rem;
  }

  .project-card__title {
    margin-bottom: 0.5rem;
  }

  .project-card__desc {
    font-size: 0.93rem;
    color: var(--color-text-muted);
    margin-bottom: 0.9rem;
  }

  .project-card__points {
    margin: 0 0 1rem 0;
    padding-left: 1.15rem;
    font-size: 0.86rem;
    display: grid;
    gap: 0.3rem;
  }

  .project-card__actions {
    border-top: 1px dashed var(--color-border);
    padding-top: 1rem;
    display: grid;
    gap: 0.75rem;
  }

  .project-card__buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .project-card__btn {
    flex: 1 1 auto;
    font-size: 0.88rem;
    padding: 0.55rem 0.95rem;
  }

  .project-card__media-toggle-container {
    width: 100%;
    height: 100%;
    position: relative;
    display: flex;
    flex-direction: column;
    background:
      radial-gradient(circle at 18% 10%, rgba(197, 245, 60, 0.22), transparent 34%),
      #10120f;
  }

  .project-card__media-view {
    width: 100%;
    height: 100%;
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #10120f;
    padding: 0.45rem;
  }

  .project-card__media-view[hidden] {
    display: none !important;
  }

  .project-card__video {
    width: 100%;
    height: 100%;
    object-fit: contain;
    background-color: #10120f;
    display: block;
    border-radius: calc(var(--radius-sm) - 3px);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.32);
  }

  .video-play-overlay {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    width: 3.75rem;
    height: 3.75rem;
    border: 1.5px solid var(--color-ink);
    border-radius: 50%;
    background: var(--color-lime);
    color: var(--color-ink);
    font-size: 1.25rem;
    cursor: pointer;
    box-shadow: 0 5px 0 var(--color-ink);
    z-index: 3;
  }

  .video-play-overlay[hidden] { display: none; }

  .video-controls {
    position: absolute;
    left: 0.85rem;
    right: 0.85rem;
    bottom: 0.85rem;
    display: grid;
    grid-template-columns: auto auto minmax(80px, 1fr) auto;
    align-items: center;
    gap: 0.55rem;
    padding: 0.45rem 0.6rem;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: var(--radius-pill);
    background: rgba(15, 18, 14, 0.84);
    backdrop-filter: blur(12px);
    color: #fff;
    z-index: 3;
    transition: opacity var(--transition-fast);
  }

  .video-control-btn {
    width: 2rem;
    height: 2rem;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: var(--color-lime);
    color: var(--color-ink);
    font: inherit;
    font-size: 0.8rem;
    font-weight: 800;
    cursor: pointer;
  }

  .video-time { white-space: nowrap; font-size: 0.72rem; font-variant-numeric: tabular-nums; }
  .video-progress { width: 100%; accent-color: var(--color-lime); cursor: pointer; }

  .project-card__media-switcher {
    position: absolute;
    top: 0.85rem;
    right: 0.85rem;
    display: flex;
    gap: 0.35rem;
    background-color: rgba(15, 18, 14, 0.82);
    backdrop-filter: blur(12px);
    padding: 0.3rem;
    border-radius: var(--radius-pill);
    z-index: 5;
    border: 1px solid rgba(255, 255, 255, 0.2);
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.28);
  }

  .media-switch-btn {
    appearance: none;
    background: transparent;
    border: none;
    color: #d0d3ca;
    font-size: 0.74rem;
    font-weight: 700;
    padding: 0.38rem 0.7rem;
    border-radius: var(--radius-pill);
    cursor: pointer;
    transition: background-color var(--transition-fast), color var(--transition-fast);
  }

  .media-switch-btn:hover {
    color: #fff;
  }

  .media-switch-btn.is-active {
    background-color: var(--color-lime);
    color: var(--color-ink);
  }

  .media-switch-btn:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 2px;
  }
</style>

<script>
  function initMediaSwitcher() {
    document.querySelectorAll('.project-card__media-toggle-container').forEach((container) => {
      const videoView = container.querySelector('[data-view="video"]') as HTMLElement | null;
      const imageView = container.querySelector('[data-view="image"]') as HTMLElement | null;
      const buttons = container.querySelectorAll<HTMLButtonElement>('[data-switch-to]');

      buttons.forEach((btn) => {
        btn.addEventListener('click', () => {
          const target = btn.getAttribute('data-switch-to');
          buttons.forEach((b) => b.classList.toggle('is-active', b === btn));
          if (target === 'video') {
            if (videoView) videoView.hidden = false;
            if (imageView) imageView.hidden = true;
          } else {
            if (videoView) {
              videoView.hidden = true;
              const vid = videoView.querySelector('video');
              if (vid && !vid.paused) vid.pause();
            }
            if (imageView) imageView.hidden = false;
          }
        });
      });

      const video = container.querySelector<HTMLVideoElement>('video');
      const toggle = container.querySelector<HTMLButtonElement>('[data-video-toggle]');
      const overlay = container.querySelector<HTMLButtonElement>('[data-video-play]');
      const mute = container.querySelector<HTMLButtonElement>('[data-video-mute]');
      const progress = container.querySelector<HTMLInputElement>('[data-video-progress]');
      const time = container.querySelector<HTMLElement>('[data-video-time]');
      const formatTime = (seconds: number) => {
        const safe = Number.isFinite(seconds) ? Math.floor(seconds) : 0;
        return `${Math.floor(safe / 60)}:${String(safe % 60).padStart(2, '0')}`;
      };
      const sync = () => {
        if (!video) return;
        const isPlaying = !video.paused && !video.ended;
        if (toggle) { toggle.textContent = isPlaying ? 'Ⅱ' : '▶'; toggle.setAttribute('aria-label', isPlaying ? 'Tạm dừng video' : 'Phát video'); }
        if (overlay) overlay.hidden = isPlaying;
        if (progress && video.duration) progress.value = String((video.currentTime / video.duration) * 100);
        if (time) time.textContent = `${formatTime(video.currentTime)} / ${formatTime(video.duration)}`;
        if (mute) mute.textContent = video.muted || video.volume === 0 ? '🔇' : '🔊';
      };
      const togglePlayback = () => { if (!video) return; video.paused ? video.play() : video.pause(); };
      toggle?.addEventListener('click', togglePlayback);
      overlay?.addEventListener('click', togglePlayback);
      mute?.addEventListener('click', () => { if (video) { video.muted = !video.muted; sync(); } });
      progress?.addEventListener('input', () => { if (video?.duration && progress) { video.currentTime = (Number(progress.value) / 100) * video.duration; } });
      video?.addEventListener('loadedmetadata', sync);
      video?.addEventListener('timeupdate', sync);
      video?.addEventListener('play', sync);
      video?.addEventListener('pause', sync);
      video?.addEventListener('ended', sync);
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initMediaSwitcher);
  } else {
    initMediaSwitcher();
  }
</script>
