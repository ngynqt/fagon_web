---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from './Hero.astro';
import ServiceSection from './ServiceSection.astro';
import ProcessSection from './ProcessSection.astro';
import Pricing from './Pricing.astro';
import FAQ from './FAQ.astro';
import ContactForm from './ContactForm.astro';
import type { AudienceConfig } from '../data/audiences';
import { getPortfolioByIds } from '../data/portfolio';

interface Props {
  audience: AudienceConfig;
}

const { audience } = Astro.props;
const demoItems = getPortfolioByIds(audience.demoIds);
---

<BaseLayout
  title={audience.seoTitle}
  description={audience.seoDescription}
  currentAudienceId={audience.id}
  ogImage={audience.ogImage}
>
  <Hero audience={audience} />
  <ServiceSection audience={audience} demoItems={demoItems} />
  <ProcessSection steps={audience.processSteps} audienceTitle={audience.title} />
  <Pricing audience={audience} />
  <FAQ faqs={audience.faqs} audienceTitle={audience.title} />
  <ContactForm defaultAudienceId={audience.id} />
</BaseLayout>
